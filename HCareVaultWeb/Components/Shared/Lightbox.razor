@if (!string.IsNullOrEmpty(Src))
{
    <div class="hv-lightbox" role="dialog" aria-modal="true" aria-label="Image preview" @onclick="OnClose">
        <img src="@Src" alt="@Caption" @onclick:stopPropagation="true" />
        <div class="hv-lightbox-bar" @onclick:stopPropagation="true">
            @if (!string.IsNullOrEmpty(Caption)) { <span>@Caption</span> }
            <a class="mt-btn mt-btn-sm" href="@Src" target="_blank" rel="noopener">Open full size</a>
            <button class="mt-btn mt-btn-sm" @onclick="OnClose">Close</button>
        </div>
    </div>
}

@code {
    [Parameter] public string? Src { get; set; }
    [Parameter] public string? Caption { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
