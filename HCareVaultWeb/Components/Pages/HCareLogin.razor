@page "/"
@page "/login"

@layout HCareVaultWeb.Components.Layout.MainLayout

@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation

<PageTitle>Sign in · HCare Vault</PageTitle>

<div class="hv-login">
    <aside class="hv-login-art">
        <div class="hv-login-brand">
            <span class="hv-logo hv-logo-lg" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm1 6v3h3v2h-3v3h-2v-3H8v-2h3V8h2Z" /></svg>
            </span>
            HCare Vault
        </div>

        <div class="hv-login-hero">
            <h1>Your family's health,<br />kept in one place.</h1>
            <p>Medicines, prescriptions, scan reports and the doctors behind them, organised for everyone you care for.</p>

            <ul class="hv-login-features">
                <li>
                    <span class="hv-feat-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M4.2 13.4a5 5 0 0 1 0-7.1l2.1-2.1a5 5 0 0 1 7.1 0l6.4 6.4a5 5 0 0 1 0 7.1l-2.1 2.1a5 5 0 0 1-7.1 0l-6.4-6.4Zm2.1-5.7-.7.7a3 3 0 0 0 0 4.2L8 15l5-5-2.6-2.6a3 3 0 0 0-4.1.3Z" /></svg>
                    </span>
                    <div><strong>Medicine cabinet</strong><span>Daily timings, stock left and refill alerts</span></div>
                </li>
                <li>
                    <span class="hv-feat-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm8 1.5V8h4.5L14 3.5ZM8 12v2h8v-2H8Zm0 4v2h5v-2H8Z" /></svg>
                    </span>
                    <div><strong>Prescriptions &amp; scans</strong><span>Dated records with photos and PDFs attached</span></div>
                </li>
                <li>
                    <span class="hv-feat-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M8 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm9 2a3 3 0 1 1 0-6 3 3 0 0 1 0 6ZM1 20c0-3.3 3.1-6 7-6s7 2.7 7 6v1H1v-1Zm15.5 1v-1c0-1.9-.7-3.6-1.9-4.9.7-.3 1.5-.6 2.4-.6 3.1 0 5 2 5 4.5V21h-5.5Z" /></svg>
                    </span>
                    <div><strong>Doctor network</strong><span>See who treated whom, and who recommended whom</span></div>
                </li>
            </ul>
        </div>

        <div class="hv-login-deco" aria-hidden="true"><i></i><i></i><i></i></div>
    </aside>

    <main class="hv-login-main">
        <div class="hv-login-card">
            <div class="hv-login-brand hv-login-brand-mobile">
                <span class="hv-logo" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm1 6v3h3v2h-3v3h-2v-3H8v-2h3V8h2Z" /></svg>
                </span>
                HCare Vault
            </div>

            <h2>Welcome back</h2>
            <p class="hv-login-sub">Sign in to open your family's health vault.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="hv-login-alert" role="alert">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20Zm-1 5v7h2V7h-2Zm0 9v2h2v-2h-2Z" /></svg>
                    @errorMessage
                </div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="Login" FormName="login">
                <DataAnnotationsValidator />

                <div class="hv-login-field">
                    <label for="username">Username</label>
                    <div class="hv-login-input">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm-9 9c0-4 4-7 9-7s9 3 9 7v1H3v-1Z" /></svg>
                        <InputText id="username" @bind-Value="loginModel.Username" placeholder="Enter your username" autocomplete="username" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Username)" class="hv-login-validation" />
                </div>

                <div class="hv-login-field">
                    <label for="password">Password</label>
                    <div class="hv-login-input">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7 10V7a5 5 0 0 1 10 0v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h6V7a3 3 0 0 0-6 0v3Zm2 5v3h2v-3h-2Z" /></svg>
                        <InputText id="password" type="@(showPassword ? "text" : "password")" @bind-Value="loginModel.Password"
                                   placeholder="Enter your password" autocomplete="current-password" />
                        <button type="button" class="hv-login-eye" aria-label="@(showPassword ? "Hide password" : "Show password")"
                                @onclick="() => showPassword = !showPassword">
                            @(showPassword ? "Hide" : "Show")
                        </button>
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" class="hv-login-validation" />
                </div>

                <button type="submit" class="hv-login-submit">
                    Sign in
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.2 5.3 19.9 12l-6.7 6.7-1.4-1.4 4.3-4.3H4v-2h12.1l-4.3-4.3 1.4-1.4Z" /></svg>
                </button>
            </EditForm>

            <p class="hv-login-foot">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Z" /></svg>
                Health records are private. Sign out when using a shared device.
            </p>
        </div>
    </main>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;
    private bool showPassword;

    private void Login()
    {
        errorMessage = string.Empty;

        // Demo credentials only.
        if (loginModel.Username == "Admin" && loginModel.Password == "Admin")
        {
            Navigation.NavigateTo("/medicines");
        }
        else
        {
            errorMessage = "Invalid username or password.";
        }
    }

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your username.")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}
