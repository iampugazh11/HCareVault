@page "/medicines/{MemberId:int}/add"
@page "/medicines/edit/{Id:int}"
@rendermode InteractiveServer
@using HCareVault.Database
@using HCareVault.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HCareDBContext> DbFactory
@inject NavigationManager Nav
@inject FileStorage Storage

<PageTitle>@(IsEdit ? "Edit medicine" : "Add medicine")</PageTitle>

<div class="mt-app">
    <AppHeader Active="medicines" MemberId="_model?.FamilyMemberId" />
    @if (_notFound)
    {
        <div class="mt-welcome">
            <h2>We couldn't find that record</h2>
            <p>The medicine or family member may have been deleted.</p>
            <a class="mt-btn mt-btn-primary" href="/medicines">Back to medicines</a>
        </div>
    }
    else if (_model is null)
    {
        <p class="mt-muted">Loading...</p>
    }
    else
    {
        <a class="mt-back" href="/medicines/@_model.FamilyMemberId">&larr; Back to @_memberName's medicines</a>
        <header class="mt-head">
            <h1>@(IsEdit ? "Edit medicine" : "Add medicine")</h1>
            <p>For @_memberName</p>
        </header>

        <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="medicineForm" class="mt-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            @if (_error is not null)
            {
                <div class="mt-error">@_error</div>
            }

            <h2 class="mt-section">Medicine</h2>
            <div class="mt-form-grid">
                <div class="mt-field">
                    <label class="mt-label">Medicine name</label>
                    <InputText class="form-control" @bind-Value="_model.MedicineName" placeholder="e.g. Metformin 500 mg" />
                </div>
                <div class="mt-field">
                    <label class="mt-label">Consultant doctor</label>
                    <InputText class="form-control" @bind-Value="_model.ConsultantDoctor" placeholder="e.g. Dr. Ramesh" />
                </div>
                <div class="mt-field">
                    <label class="mt-label">Status</label>
                    <InputSelect class="form-select" @bind-Value="_model.Status">
                        <option value="@MedicationStatus.Active">Taking now</option>
                        <option value="@MedicationStatus.Stopped">Stopped</option>
                    </InputSelect>
                </div>
            </div>

            <h2 class="mt-section">Stock</h2>
            <div class="mt-form-grid">
                <div class="mt-field">
                    <label class="mt-label">Tablets bought</label>
                    <InputNumber class="form-control" @bind-Value="_model.TabletsBought" />
                </div>
                <div class="mt-field">
                    <label class="mt-label">Tablets left</label>
                    <InputNumber class="form-control" @bind-Value="_model.TabletsLeft" />
                </div>
                <div class="mt-field">
                    <label class="mt-label">Last bought on</label>
                    <InputDate class="form-control" @bind-Value="_model.LastPurchasedOn" />
                </div>
            </div>

            <h2 class="mt-section">Daily schedule</h2>
            <div class="mt-form-grid">
                <div class="mt-field mt-slot-field slot-morning">
                    <label class="mt-label">Morning</label>
                    <InputSelect class="form-select" @bind-Value="_model.Morning">
                        <option value="@MealTiming.None">Not taken</option>
                        <option value="@MealTiming.BeforeFood">Before food</option>
                        <option value="@MealTiming.AfterFood">After food</option>
                    </InputSelect>
                </div>
                <div class="mt-field mt-slot-field slot-afternoon">
                    <label class="mt-label">Afternoon</label>
                    <InputSelect class="form-select" @bind-Value="_model.Afternoon">
                        <option value="@MealTiming.None">Not taken</option>
                        <option value="@MealTiming.BeforeFood">Before food</option>
                        <option value="@MealTiming.AfterFood">After food</option>
                    </InputSelect>
                </div>
                <div class="mt-field mt-slot-field slot-night">
                    <label class="mt-label">Night</label>
                    <InputSelect class="form-select" @bind-Value="_model.Night">
                        <option value="@MealTiming.None">Not taken</option>
                        <option value="@MealTiming.BeforeFood">Before food</option>
                        <option value="@MealTiming.AfterFood">After food</option>
                    </InputSelect>
                </div>
            </div>

            <h2 class="mt-section">Notes</h2>
            <div class="mt-field">
                <InputText class="form-control" @bind-Value="_model.Notes" placeholder="Optional, e.g. take with plenty of water" />
            </div>

            <h2 class="mt-section">Photo <span class="mt-muted">(optional)</span></h2>
            <div class="hv-photo-field">
                <div class="hv-photo-preview">
                    @if (PreviewSrc is { } src)
                    {
                        <img src="@src" alt="Photo of @_model.MedicineName" />
                    }
                    else
                    {
                        <div class="mt-pill-art" aria-hidden="true"><i></i><i></i></div>
                    }
                </div>
                <div>
                    <p class="mt-note hv-mb">A photo of the strip or box makes it easy to recognise when buying again.</p>
                    <div class="hv-inline">
                        <label class="mt-btn hv-file-btn">
                            <InputFile OnChange="OnPhotoSelected" accept="image/*" />
                            @(_uploading ? "Reading..." : PreviewSrc is null ? "Upload photo" : "Change photo")
                        </label>
                        @if (PreviewSrc is not null)
                        {
                            <button type="button" class="mt-btn" @onclick="RemovePhoto">Remove photo</button>
                        }
                    </div>
                    @if (_photoError is not null)
                    {
                        <div class="mt-error">@_photoError</div>
                    }
                </div>
            </div>

            <div class="mt-form-actions">
                <button type="submit" class="mt-btn mt-btn-primary" disabled="@_uploading">Save medicine</button>
                <a class="mt-btn" href="/medicines/@_model.FamilyMemberId">Cancel</a>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int? MemberId { get; set; }

    private Medication? _model;
    private string _memberName = "";
    private string? _error;
    private bool _notFound;

    // Photo: the stored file loaded with the record, and any change made on this form.
    private string? _originalImage;
    private PendingUpload? _newPhoto;
    private bool _photoRemoved;
    private bool _uploading;
    private string? _photoError;

    private bool IsEdit => Id.HasValue;

    private string? PreviewSrc =>
        _newPhoto is not null ? _newPhoto.DataUrl
        : !_photoRemoved && _originalImage is not null ? FileStorage.Url(_originalImage)
        : null;

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        _photoError = null;
        _uploading = true;
        try
        {
            // Shrink in the browser first: phone photos are often several MB.
            var resized = await e.File.RequestImageFileAsync("image/jpeg", 1200, 1200);
            var photo = await FileStorage.ReadAsync(resized, FileStorage.MaxImageBytes);
            _newPhoto = photo with { FileName = Path.ChangeExtension(e.File.Name, ".jpg"), ContentType = "image/jpeg" };
        }
        catch (Exception)
        {
            _photoError = "Could not read that image. Please choose a JPG, PNG or WEBP photo under 5 MB.";
        }
        finally
        {
            _uploading = false;
        }
    }

    private void RemovePhoto()
    {
        _newPhoto = null;
        _photoRemoved = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        _notFound = false;
        await using var db = await DbFactory.CreateDbContextAsync();

        if (Id.HasValue)
        {
            _model = await db.Medications.AsNoTracking().FirstOrDefaultAsync(m => m.Id == Id.Value);
            if (_model is null) { _notFound = true; return; }
            _originalImage = _model.ImageFile;
        }
        else
        {
            _model = new Medication { FamilyMemberId = MemberId ?? 0, LastPurchasedOn = DateTime.Today };
        }

        var member = await db.FamilyMembers.AsNoTracking().FirstOrDefaultAsync(m => m.Id == _model.FamilyMemberId);
        if (member is null) { _model = null; _notFound = true; return; }
        _memberName = member.Name;
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;
        _error = null;

        if (_model.TabletsLeft > _model.TabletsBought)
        {
            _error = "Tablets left cannot be more than tablets bought.";
            return;
        }

        var replacesOriginal = _newPhoto is not null || _photoRemoved;
        if (_newPhoto is not null) _model.ImageFile = await Storage.SaveAsync(_newPhoto);
        else if (_photoRemoved) _model.ImageFile = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (IsEdit) db.Medications.Update(_model);
        else db.Medications.Add(_model);

        await db.SaveChangesAsync();
        if (replacesOriginal) Storage.Delete(_originalImage);
        Nav.NavigateTo($"/medicines/{_model.FamilyMemberId}");
    }
}
